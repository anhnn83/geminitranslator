{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the windows",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "core:tray:default",
    "global-shortcut:default",
    "clipboard-manager:allow-read-text",
    "core:window:allow-start-dragging",
    "autostart:default"
  ]
}